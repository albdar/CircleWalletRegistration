{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/wallets",
      "destination": "/"
    },
    {
      "source": "/wallets/",
      "destination": "/"
    },
    {
      "source": "/wallets/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/wallets/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
