{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",

  "redirects": [
    {
      "source": "/wallets",
      "destination": "/wallets/",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/wallets/:path*",
      "destination": "https://circlewalletregistration.vercel.app/:path*"
    }
  ]
}