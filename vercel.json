{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/wallets",
      "destination": "https://circlewalletregistration.vercel.app/"
    },
    {
      "source": "/wallets/:path*",
      "destination": "https://circlewalletregistration.vercel.app/:path*"
    }
  ]
}