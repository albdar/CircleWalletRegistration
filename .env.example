# Server only. Never expose this with a VITE_ prefix.
CIRCLE_API_KEY=YOUR_CIRCLE_API_KEY

# Circle User-Controlled Wallet App ID. This value is used by the Web SDK in the browser.
VITE_CIRCLE_APP_ID=YOUR_CIRCLE_APP_ID

# Target network is selected in the UI.
# The backend accepts only ETH-SEPOLIA and ARC-TESTNET.

# Optional. Normally do not change.
CIRCLE_BASE_URL=https://api.circle.com
