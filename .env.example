# Circle TEST environment (needed for Arc Testnet / Ethereum Sepolia)
CIRCLE_TEST_API_KEY=TEST_API_KEY:YOUR_TEST_KEY

# Circle LIVE environment (needed for Arc Mainnet)
CIRCLE_LIVE_API_KEY=LIVE_API_KEY:YOUR_LIVE_KEY

# Optional backwards-compatible single-key fallback.
# Use only if you deploy a build for one environment at a time.
# CIRCLE_API_KEY=LIVE_API_KEY:YOUR_LIVE_KEY

# Optional. Normally do not change.
CIRCLE_BASE_URL=https://api.circle.com

# No VITE_CIRCLE_APP_ID is required anymore.
# The server retrieves the matching App ID from Circle using /v1/w3s/config/entity.
