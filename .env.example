# Server only. Never expose this with a VITE_ prefix.
CIRCLE_API_KEY=YOUR_CIRCLE_API_KEY

# Circle User-Controlled Wallet App ID. This value is used by the Web SDK in the browser.
VITE_CIRCLE_APP_ID=YOUR_CIRCLE_APP_ID

# Ethereum Sepolia + Smart Contract Account.
CIRCLE_BLOCKCHAIN=ETH-SEPOLIA

# Optional. Normally do not change.
CIRCLE_BASE_URL=https://api.circle.com

# Wallet application login. Server only; do not use a VITE_ prefix.
WALLET_LOGIN_USER=walletadmin
WALLET_LOGIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Generate a random value, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
WALLET_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
